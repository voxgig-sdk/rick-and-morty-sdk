  id: {
    field: "id"
    name: "id"
  }

  name: "character"
  op: {
    list: {
      name: "list"
      points: [
        {
          co: {
            id: "GET /character"
            source: "openapi3"
            version: 2
          }
          g: {
            query: [
              {
