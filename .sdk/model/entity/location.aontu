# Entity: location

main: kit: entity: location: {

  alias: field: {}

  fields: {
    created: {
      fo: "date-time"
      h: "Created"
      n: "created"
      r: false
      sh: "Time at which the location was created in the database"
      t: "`$STRING`"
    }
    dimension: {
      h: "Dimension"
      n: "dimension"
      r: false
      sh: "The dimension in which the location is located"
      t: "`$STRING`"
    }
    id: {
      h: "Id"
      n: "id"
      r: false
      sh: "The id of the location"
      t: "`$INTEGER`"
    }
    name: {
      h: "Name"
      n: "name"
      r: false
      sh: "The name of the location"
      t: "`$STRING`"
    }
    residents: {
      h: "Residents"
      n: "residents"
      r: false
      sh: "List of characters who have been last seen in this location"
      t: "`$ARRAY`"
    }
    type: {
      h: "Type"
      n: "type"
      r: false
      sh: "The type of the location"
      t: "`$STRING`"
    }
    url: {
      h: "Url"
      n: "url"
      r: false
      sh: "Link to the location's own URL endpoint"
      t: "`$STRING`"
    }
  }

  id: {
    field: "id"
    name: "id"
  }

  name: "location"
  op: {
    list: {
      name: "list"
      points: [
        {
          co: {
            id: "GET /location"
            source: "openapi3"
            version: 2
          }
          g: {
            query: [
              {
                k: "query"
                n: "dimension"
                or: "dimension"
                r: false
                t: "`$STRING`"
              }
              {
                k: "query"
                n: "name"
                or: "name"
                r: false
                t: "`$STRING`"
              }
              {
                ex: 1
                k: "query"
                n: "page"
                or: "page"
                r: false
                t: "`$INTEGER`"
              }
              {
                k: "query"
                n: "type"
                or: "type"
                r: false
                t: "`$STRING`"
              }
            ]
          }
          m: "GET"
          o: "/location"
          q: {
            exist: [
              "dimension"
              "name"
              "page"
              "type"
            ]
          }
          s: [
            {
              lit: "location"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
    load: {
      name: "load"
      points: [
        {
          co: {
            id: "GET /location/{id}"
            source: "openapi3"
            version: 2
          }
          g: {
            params: [
              {
                k: "param"
                n: "id"
                or: "id"
                r: true
                t: "`$STRING`"
              }
            ]
          }
          m: "GET"
          o: "/location/{id}"
          q: {
            exist: [
              "id"
            ]
          }
          s: [
            {
              lit: "location"
            }
            {
              var: "id"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
