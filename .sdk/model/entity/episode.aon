# Entity: episode

main: kit: entity: episode: {

  alias: field: {}

  fields: [
    {
      name: "air_date"
      req: false
      short: "The air date of the episode"
      type: "`$STRING`"
    }
    {
      name: "characters"
      req: false
      short: "List of characters who have been seen in this episode"
      type: "`$ARRAY`"
    }
    {
      name: "created"
      req: false
      short: "Time at which the episode was created in the database"
      type: "`$STRING`"
    }
    {
      name: "episode"
      req: false
      short: "The code of the episode (e.g., S01E01)"
      type: "`$STRING`"
    }
    {
      name: "id"
      req: false
      short: "The id of the episode"
      type: "`$INTEGER`"
    }
    {
      name: "name"
      req: false
      short: "The name of the episode"
      type: "`$STRING`"
    }
    {
      name: "url"
      req: false
      short: "Link to the episode's own URL endpoint"
      type: "`$STRING`"
    }
  ]

  id: {
    field: "id"
    name: "id"
  }

  name: "episode"
  op: {
    list: {
      name: "list"
      points: [
        {
          args: {
            query: [
              {
                kind: "query"
                name: "episode"
                orig: "episode"
                reqd: false
                type: "`$STRING`"
              }
              {
                kind: "query"
                name: "name"
                orig: "name"
                reqd: false
                type: "`$STRING`"
              }
              {
                example: 1
                kind: "query"
                name: "page"
                orig: "page"
                reqd: false
                type: "`$INTEGER`"
              }
            ]
          }
          method: "GET"
          orig: "/episode"
          parts: [
            "episode"
          ]
          select: {
            exist: [
              "episode"
              "name"
              "page"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
    load: {
      name: "load"
      points: [
        {
          args: {
            params: [
              {
                kind: "param"
                name: "id"
                orig: "id"
                reqd: true
                type: "`$STRING`"
              }
            ]
          }
          method: "GET"
          orig: "/episode/{id}"
          parts: [
            "episode"
            "{id}"
          ]
          select: {
            exist: [
              "id"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
