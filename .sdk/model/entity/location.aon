# Entity: location

main: kit: entity: location: {

  alias: field: {}

  fields: [
    {
      name: "created"
      req: false
      short: "Time at which the location was created in the database"
      type: "`$STRING`"
    }
    {
      name: "dimension"
      req: false
      short: "The dimension in which the location is located"
      type: "`$STRING`"
    }
    {
      name: "id"
      req: false
      short: "The id of the location"
      type: "`$INTEGER`"
    }
    {
      name: "name"
      req: false
      short: "The name of the location"
      type: "`$STRING`"
    }
    {
      name: "residents"
      req: false
      short: "List of characters who have been last seen in this location"
      type: "`$ARRAY`"
    }
    {
      name: "type"
      req: false
      short: "The type of the location"
      type: "`$STRING`"
    }
    {
      name: "url"
      req: false
      short: "Link to the location's own URL endpoint"
      type: "`$STRING`"
    }
  ]

  id: {
    field: "id"
    name: "id"
  }

  name: "location"
  op: {
    list: {
      name: "list"
      points: [
        {
          args: {
            query: [
              {
                kind: "query"
                name: "dimension"
                orig: "dimension"
                reqd: false
                type: "`$STRING`"
              }
              {
                kind: "query"
                name: "name"
                orig: "name"
                reqd: false
                type: "`$STRING`"
              }
              {
                example: 1
                kind: "query"
                name: "page"
                orig: "page"
                reqd: false
                type: "`$INTEGER`"
              }
              {
                kind: "query"
                name: "type"
                orig: "type"
                reqd: false
                type: "`$STRING`"
              }
            ]
          }
          method: "GET"
          orig: "/location"
          parts: [
            "location"
          ]
          select: {
            exist: [
              "dimension"
              "name"
              "page"
              "type"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
    load: {
      name: "load"
      points: [
        {
          args: {
            params: [
              {
                kind: "param"
                name: "id"
                orig: "id"
                reqd: true
                type: "`$STRING`"
              }
            ]
          }
          method: "GET"
          orig: "/location/{id}"
          parts: [
            "location"
            "{id}"
          ]
          select: {
            exist: [
              "id"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
