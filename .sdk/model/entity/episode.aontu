# Entity: episode

main: kit: entity: episode: {

  alias: field: {}

  fields: {
    air_date: {
      h: "Air Date"
      n: "air_date"
      r: false
      sh: "The air date of the episode"
      t: "`$STRING`"
    }
    characters: {
      h: "Characters"
      n: "characters"
      r: false
      sh: "List of characters who have been seen in this episode"
      t: "`$ARRAY`"
    }
    created: {
      fo: "date-time"
      h: "Created"
      n: "created"
      r: false
      sh: "Time at which the episode was created in the database"
      t: "`$STRING`"
    }
    episode: {
      h: "Episode"
      n: "episode"
      r: false
      sh: "The code of the episode (e.g., S01E01)"
      t: "`$STRING`"
    }
    id: {
      h: "Id"
      n: "id"
      r: false
      sh: "The id of the episode"
      t: "`$INTEGER`"
    }
    name: {
      h: "Name"
      n: "name"
      r: false
      sh: "The name of the episode"
      t: "`$STRING`"
    }
    url: {
      h: "Url"
      n: "url"
      r: false
      sh: "Link to the episode's own URL endpoint"
      t: "`$STRING`"
    }
  }

  id: {
    field: "id"
    name: "id"
  }

  name: "episode"
  op: {
    list: {
      name: "list"
      points: [
        {
          co: {
            id: "GET /episode"
            source: "openapi3"
            version: 2
          }
          g: {
            query: [
              {
                k: "query"
                n: "episode"
                or: "episode"
                r: false
                t: "`$STRING`"
              }
              {
                k: "query"
                n: "name"
                or: "name"
                r: false
                t: "`$STRING`"
              }
              {
                ex: 1
                k: "query"
                n: "page"
                or: "page"
                r: false
                t: "`$INTEGER`"
              }
            ]
          }
          m: "GET"
          o: "/episode"
          q: {
            exist: [
              "episode"
              "name"
              "page"
            ]
          }
          s: [
            {
              lit: "episode"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
    load: {
      name: "load"
      points: [
        {
          co: {
            id: "GET /episode/{id}"
            source: "openapi3"
            version: 2
          }
          g: {
            params: [
              {
                k: "param"
                n: "id"
                or: "id"
                r: true
                t: "`$STRING`"
              }
            ]
          }
          m: "GET"
          o: "/episode/{id}"
          q: {
            exist: [
              "id"
            ]
          }
          s: [
            {
              lit: "episode"
            }
            {
              var: "id"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
