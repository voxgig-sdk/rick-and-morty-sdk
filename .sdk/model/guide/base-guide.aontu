    }
    path: "/character/{id}": {
      op: load: method: *GET
    }
  }

  entity: episode: {
    path: "/episode": {
      op: list: method: *GET
    }
    path: "/episode/{id}": {
      op: load: method: *GET
    }
  }

  entity: location: {
    path: "/location": {
      op: list: method: *GET
    }
    path: "/location/{id}": {
      op: load: method: *GET
    }
  }

}